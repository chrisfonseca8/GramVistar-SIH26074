# Copy to .env.local and fill in to enable live Gemini calls.
# The app works fully without this file — mock mode is the default and
# every check in this app runs entirely against it.
#
# Both variables must be set to use live Gemini — if either is missing,
# the app silently falls back to mock mode rather than breaking.

# Set to "false" to attempt live Gemini calls instead of the mock generator.
NEXT_PUBLIC_USE_STUB_LLM=true

# Required only when NEXT_PUBLIC_USE_STUB_LLM=false.
#
# WARNING: NEXT_PUBLIC_ vars are bundled into client-side JavaScript and are
# visible to anyone who opens the app in a browser. This is fine for local
# prototyping only — a browser-exposed API key is not suitable for
# production; production live-LLM access needs a server-side secret
# boundary, which is outside this frontend-only prototype's scope.
NEXT_PUBLIC_GEMINI_API_KEY=your_api_key_here
